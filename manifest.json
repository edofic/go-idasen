{
  "schemaVersion": 1,
  "id": "edofic.idasen-desk",
  "name": "IDÅSEN Desk",
  "version": "0.2.0",
  "author": "Andraz Bajt",
  "description": "Live height monitoring and controls for an IKEA IDÅSEN desk",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "omarchy/Panel.qml"
  },
  "barWidget": {
    "displayName": "IDÅSEN Desk",
    "description": "Live height and movement controls",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "binaryPath": "",
      "adjustmentMm": 5
    },
    "schema": [
      { "key": "binaryPath", "type": "string", "label": "Controller path" },
      { "key": "adjustmentMm", "type": "number", "label": "Adjustment step (mm)", "min": 1, "max": 100 }
    ]
  }
}
